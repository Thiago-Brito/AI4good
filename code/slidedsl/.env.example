# Copie para .env local. Nunca coloque uma chave real neste exemplo.
OPENAI_API_KEY=
SLIDEDSL_OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Opcional: caminho absoluto do Node 24 portátil
SLIDEDSL_NODE=
# Contato (e-mail ou site) exigido pela Wikimedia no User-Agent; sem ele, a busca de imagens recebe HTTP 403
SLIDEDSL_CONTACT=

# Opcional: tarifas de texto em USD por milhão, conferidas para modelo e data.
# Sem tarifa configurada, o custo aparece como desconhecido.
# SLIDEDSL_OPENAI_PRICING={"modelo":{"input":0.4,"cached_input":0.1,"output":1.6,"date":"2026-11-01"}}
