{
  "$defs": {
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 1280,
          "default": 1280,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "const": 720,
          "default": 720,
          "title": "Height",
          "type": "integer"
        },
        "unit": {
          "const": "px_logico",
          "default": "px_logico",
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "Canvas",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "rectangle",
            "ellipse",
            "text",
            "image",
            "arrow"
          ],
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        },
        "z": {
          "default": 0,
          "title": "Z",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "font_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size"
        },
        "font_face": {
          "default": "Arial",
          "title": "Font Face",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "titulo",
                "corpo",
                "decoracao",
                "background"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "role_origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Origin"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "source_column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column"
        }
      },
      "required": [
        "id",
        "type",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Element",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        }
      },
      "required": [
        "id",
        "members"
      ],
      "title": "Group",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "below",
            "right",
            "left",
            "align_right",
            "center",
            "top"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "margin": {
          "default": 0,
          "title": "Margin",
          "type": "number"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "source_column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column"
        }
      },
      "required": [
        "kind",
        "target",
        "reference"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Slide": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Elements",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/Group"
          },
          "title": "Groups",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        }
      },
      "required": [
        "number",
        "elements"
      ],
      "title": "Slide",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "theme": {
      "enum": [
        "claro",
        "escuro"
      ],
      "title": "Theme",
      "type": "string"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/Slide"
      },
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "title",
    "theme",
    "slides"
  ],
  "title": "Presentation",
  "type": "object"
}
